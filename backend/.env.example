# AI Hiring & Candidate Evaluation Platform — Environment Configuration Template

APP_NAME="AI Unified Recruitment Platform"
APP_VERSION="1.0.0"
DEBUG=True

# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_hiring_db

# Security & Secrets
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (Optional for 6-Digit OTP Delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-hiring.com
SMTP_FALLBACK_ON_FAILURE=True

# External Job Provider API Configuration
JOB_PROVIDER=demo
JOB_API_KEY=
JOB_API_URL=
