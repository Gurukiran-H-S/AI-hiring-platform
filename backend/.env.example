# ===================================================================
# HireAI Platform - Environment Configuration Template
# ===================================================================

# --- Application ---
APP_NAME="AI Unified Recruitment Platform"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_hiring_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT Authentication ---
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Job Market Intelligence & Technology Trend Analyzer ---
# Job Market APIs (RemoteOK, Arbeitnow, Adzuna, Jooble, etc.)
MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDER=remoteok,arbeitnow,adzuna,internal
MARKET_API_KEY=

# GitHub Developer Ecosystem Data (Optional personal access token for higher rate limits)
GITHUB_ENABLED=true
GITHUB_TOKEN=

# Google Trends Search Interest Data (Optional)
GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_API_KEY=

# Scheduled Data Collection Frequency (in seconds: 86400 = 24 hours / daily at 02:00 AM)
MARKET_COLLECTION_INTERVAL=86400

# --- Email / SMTP Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@hireai.com
SMTP_FALLBACK_ON_FAILURE=true

# --- AI & NLP Models ---
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# --- CORS & Client URLs ---
FRONTEND_URL=http://localhost:5173
